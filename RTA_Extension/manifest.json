{
  "manifest_version": 3,
  "name": "RTA – RollerCoin Task Assistant",
  "version": "0.6.0",
  "description": "RTA Scanner mit lokaler TestApp-Anbindung.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://rollercoin.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RTA Scanner"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rollercoin.com/taskwall/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}